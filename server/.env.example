# ==============================================================================
# Hostinger / Production Deployment — Dashboard Backend (.env)
# ------------------------------------------------------------------------------
# In Hostinger File Manager:
# 1. Rename this file to `.env` (or create a new file named `.env`).
# 2. Set your Supabase or Hostinger MySQL credentials and strong random secrets.
# ==============================================================================

NODE_ENV=production
PORT=8001
TRUST_PROXY_HOPS=1

# Public URL of this dashboard server
DASHBOARD_PUBLIC_URL=https://dashboard.devinquire.com
VITE_PUBLIC_URL=https://dashboard.devinquire.com

# CORS Allowed Origins (Comma-separated, no trailing slashes)
ALLOWED_ORIGINS=https://dashboard.devinquire.com,https://devinquire.com,https://www.devinquire.com

# Session Security (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace_with_strong_session_secret_min_32_characters
SESSION_MAX_AGE=86400000
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Primary Database (Supabase PostgreSQL Recommended)
DATABASE_URL=postgresql://postgres.mcyngpjwkcxodglewdwd:your_supabase_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_TYPE=postgres

# Fallback Database (Hostinger MySQL)
DB_HOST=localhost
DB_PORT_MYSQL=3306
DB_USER=u123456789_dbuser
DB_PASS=your_hostinger_mysql_password
DB_NAME=u123456789_dbname
DB_POOL_MAX=20

# Main Site Blog Sync Webhook
# (Must match SYNC_WEBHOOK_SECRET in devinquire.com backend .env)
MAINSITE_SYNC_WEBHOOK_URL=https://devinquire.com/api/sync-posts?token=replace_with_strong_sync_webhook_secret_min_32_chars

# Google Gemini API Key (For AI Blog Writing & Autocomplete)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Outbound Email (SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=contact@devinquire.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=contact@devinquire.com

# Feature Flags
ENABLE_PUBLIC_BLOG_LIST=true
