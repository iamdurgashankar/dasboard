# ==============================================================================
# Hostinger Node.js Web App — Production Environment (.env)
# ==============================================================================

NODE_ENV=production
PORT=8001
TRUST_PROXY_HOPS=1

# Public URL of this dashboard server
DASHBOARD_PUBLIC_URL=https://dashboard.devinquire.com
VITE_PUBLIC_URL=https://dashboard.devinquire.com

# CORS Allowed Origins (Comma-separated, no trailing slashes)
ALLOWED_ORIGINS=https://dashboard.devinquire.com,https://devinquire.com,https://www.devinquire.com

# Session Security
SESSION_SECRET=f4a8e9c21d7b3a609e5f1c8d4a2b7e0f9c3d6a1e8b4f2c7d9a0e3b6f1c4d8a2e
SESSION_MAX_AGE=604800000
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Primary Database (Hostinger MySQL)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT_MYSQL=3306
DB_USER=u180145459_dashboard_dev
DB_PASS=DevInquire2026!
DB_NAME=u180145459_dashboard_dev
DB_POOL_MAX=20

# Default Admin Credentials (Auto-seeded on first start)
ADMIN_EMAIL=admin@devinquire.com
ADMIN_PASSWORD=DevInquire2025!

# Main Site Blog Sync Webhook
MAINSITE_SYNC_WEBHOOK_URL=https://devinquire.com/api/sync-posts?token=devinquire-secret-token-123

# Google Gemini API Key (For DI AI & Blog Writing)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Outbound Email (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=contact@devinquire.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=contact@devinquire.com

# Feature Flags
ENABLE_PUBLIC_BLOG_LIST=true

# Meta (Facebook Page + Instagram Business) OAuth & Graph API (Optional — can also be configured in Dashboard UI)
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
SOCIAL_AUTOMATION_WEBHOOK_URL=
