{
  "name": "devinquire-pro-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "server": "npm --prefix server run dev",
    "backend": "npm --prefix server start",
    "seed": "npm --prefix server run seed",
    "cron:generate-blog": "node server/cron/generateBlog.js",
    "postinstall": "npm --prefix server install --omit=dev",
    "build": "tsc --noEmit && vite build",
    "build:ci": "CI=true tsc --noEmit --pretty false && CI=true vite build",
    "start": "node server.js",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.35.0",
    "@supabase/supabase-js": "^2.43.4",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.18",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0",
    "mysql2": "^3.22.5",
    "pg": "^8.12.0",
    "postcss": "^8.4.35",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.12.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}